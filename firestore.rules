rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net & Admin override: Allow read for the secure Admin UID
    match /{document=**} {
      allow read: if request.auth != null && request.auth.uid == '9ZiRLy3D71SgLxAWAaBaUFW3tvA2';
      allow write: if false;
    }

    // Reusable validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == '9ZiRLy3D71SgLxAWAaBaUFW3tvA2';
    }

    // User profile rules
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Goals collection rules
    match /goals/{goalId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Files metadata rules
    match /files/{fileId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
